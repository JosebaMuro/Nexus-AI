    <node id="art:Cuadro político">
      <data key="capa">2-articulos</data>
      <data key="descripcion">Militante y dirigente intermedio de una organización política</data>
      <data key="label">Cuadro político</data>
      <data key="resumen">Un cuadro político está formado por personas con habilidades de liderazgo que forman parte de un partido político.​</data>
      <data key="type">articulo</data>
      <data key="url">https://es.wikipedia.org/wiki/Cuadro_político</data>
