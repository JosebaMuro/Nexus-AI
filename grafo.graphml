      <data key="wikidata">Q65159494</data>
    </node>
    <node id="art:Digital Research Infrastructure for the Arts and Humanities">
      <data key="capa">2-articulos</data>
      <data key="fundacion">2014-08</data>
      <data key="label">Digital Research Infrastructure for the Arts and Humanities</data>
      <data key="resumen">La Digital Research Infrastructure for the Arts and Humanities (Infraestructura de Investigación Digital para las Artes y Humanidades, más conocida por su acrónimo DARIAH) es una infraestructura europea de investigación creada para mejorar y apoyar la investigación y la enseñanza en las Artes y Humanidades que se apoyan en recursos digitales (es decir, Arte y Humanidades digitales). DARIAH es un Consorcio Europeo de Infraestructura de Investigación (ERIC) desde 2014.</data>
      <data key="type">articulo</data>
      <data key="url">https://es.wikipedia.org/wiki/Digital_Research_Infrastructure_for_the_Arts_and_Humanities</data>
      <data key="web">https://www.dariah.eu</data>
      <data key="wikidata">Q49103279</data>
