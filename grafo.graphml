    <node id="art:Richard Ingersoll">
      <data key="capa">2-articulos</data>
      <data key="descripcion">arquitecto e historiador estadounidense (1949-)</data>
      <data key="fallecimiento">2021-02-27</data>
      <data key="label">Richard Ingersoll</data>
      <data key="nacimiento">1949</data>
      <data key="resumen">Richard Ingersoll (San Francisco, 1949-Huebro, Almería, España; 27 de febrero de 2021)​​ fue un arquitecto, historiador, editor y autor especialista en arquitectura renacentista italiana y profesor de arquitectura estadounidense.​</data>
