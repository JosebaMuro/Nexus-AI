    <node id="art:Josefina Lavalle">
      <data key="capa">2-articulos</data>
      <data key="fallecimiento">2009-05-25</data>
      <data key="label">Josefina Lavalle</data>
      <data key="nacimiento">1924-01-29</data>
      <data key="resumen">Josefina Martínez Lavalle (México D.F., 29 de enero de 1924 – ibíd. 25 de mayo de 2009​) fue una bailarina y coreógrafa mexicana que tuvo también una destacada labor como maestra y funcionaria. Junto con otras destacadas maestras y coreógrafas jugó un papel muy importante en la creación y desarrollo de la danza moderna en México.</data>
      <data key="type">articulo</data>
      <data key="url">https://es.wikipedia.org/wiki/Josefina_Lavalle</data>
