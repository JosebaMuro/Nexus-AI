      <data key="capa">2-articulos</data>
      <data key="fundacion">1960-02-18</data>
      <data key="label">Asociación Latinoamericana de Libre Comercio</data>
      <data key="resumen">La Asociación Latinoamericana de Libre Comercio (ALALC) fue un organismo regional, latinoamericano existente entre 1960-1980. Creado el 18 de febrero de 1960 por el Tratado de Montevideo.</data>
