      <data key="label">Ana Fani Alessandri Carlos</data>
      <data key="nacimiento">1952-05-22</data>
      <data key="resumen">Ana Fani Alessandri Carlos (1950) es una geógrafa brasileña. Es profesora titular del Departamento de Geografía de la Universidad de São Paulo, coordinadora del Grupo de Estudios sobre São Paulo​​ Ha concentrado sus estudios sobre la metrópolis paulistana​ y de las transformaciones espaciales derivadas del desarrollo de la capital.</data>
      <data key="type">articulo</data>
      <data key="url">https://es.wikipedia.org/wiki/Ana_Fani_Alessandri_Carlos</data>
      <data key="web">https://www.anafani.com.br/</data>
      <data key="wikidata">Q276435</data>
    </node>
    <node id="art:Harriet Chalmers Adams">
      <data key="capa">2-articulos</data>
      <data key="descripcion">exploradora, escritora y fotógrafa estadounidense</data>
