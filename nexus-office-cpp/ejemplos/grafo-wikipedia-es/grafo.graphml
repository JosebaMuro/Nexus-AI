      <data key="descripcion">página de desambiguación de Wikimedia</data>
      <data key="label">Vida (desambiguación)</data>
      <data key="resumen">El término Vida se refiere generalmente a la Vida desde el punto de vista biológico, pero también hace referencia a otros artículos:</data>
      <data key="type">articulo</data>
      <data key="url">https://es.wikipedia.org/wiki/Vida_(desambiguación)</data>
      <data key="wikidata">Q349124</data>
    </node>
    <node id="art:Ciencias del karst">
      <data key="capa">2-articulos</data>
      <data key="descripcion">conjunto de disciplinas que investigan los sistemas kársticos</data>
      <data key="label">Ciencias del karst</data>
      <data key="resumen">Ciencias del karst o karstología es el conjunto de disciplinas que investigan los sistemas kársticos.​</data>
      <data key="type">articulo</data>
      <data key="url">https://es.wikipedia.org/wiki/Ciencias_del_karst</data>
