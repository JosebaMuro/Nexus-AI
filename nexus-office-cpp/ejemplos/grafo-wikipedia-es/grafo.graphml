    <node id="art:Casa América Cataluña">
      <data key="capa">2-articulos</data>
      <data key="fundacion">2005</data>
      <data key="label">Casa América Cataluña</data>
      <data key="resumen">Casa América Cataluña (Casa Amèrica Catalunya, en su denominación oficial en catalán) es una fundación catalana creada para generar, impulsar, difundir e intercambiar conocimientos de las realidades culturales, económicas e históricas de los diferentes países de la América Latina con el fin de fortalecer y ampliar las relaciones entre la comunidad iberoamericana y Cataluña. Se considera descendiente de la Casa de América de Barcelona, fundada en 1911,​ y a la vez heredera del Instituto Catalán de Cooperación Iberoamericana.</data>
      <data key="type">articulo</data>
      <data key="url">https://es.wikipedia.org/wiki/Casa_América_Cataluña</data>
      <data key="web">https://americat.barcelona/</data>
      <data key="wikidata">Q104436620</data>
    </node>
