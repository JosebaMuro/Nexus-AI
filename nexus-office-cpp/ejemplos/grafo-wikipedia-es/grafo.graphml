    </node>
    <node id="art:Diego Álvarez de Toledo">
      <data key="capa">2-articulos</data>
      <data key="fallecimiento">1557</data>
      <data key="label">Diego Álvarez de Toledo</data>
      <data key="nacimiento">1460</data>
      <data key="resumen">Diego de Toledo o Diego Álvarez de Toledo fue uno de los hijos del segundo Duque de Alba, Fadrique Álvarez de Toledo, e Isabel de Zúñiga y Pimentel. Participó junto a su padre en la campaña de Navarra en 1512 y fue Prior de la Orden de San Juan.</data>
      <data key="type">articulo</data>
